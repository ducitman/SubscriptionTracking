# Google Cloud OAuth web application credentials. Do not commit your real .env file.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Local: http://localhost:5173/api/oauth-callback
# Vercel: https://your-domain.vercel.app/api/oauth-callback
GOOGLE_REDIRECT_URI=http://localhost:5173/api/oauth-callback
# A long, random private value used to protect OAuth state.
OAUTH_STATE_SECRET=
